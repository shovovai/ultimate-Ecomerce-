NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=


# Email Service Configuration (Gmail OAuth2)
# Google OAuth for Email (Legacy naming - kept for compatibility)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Get refresh token from: https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=
SENDER_EMAIL_ADDRESS=

# Node Environment

# Run webhook listener locally using the command below:
# stripe listen --forward-to localhost:3000/api/webhook
# Optional: Google AdSense publisher ID (ads disabled when empty)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# Optional: Google Search Console verification code
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Encrypts payment gateway credentials saved from Admin → Payments (long random string).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PAYMENT_ENCRYPTION_KEY=
